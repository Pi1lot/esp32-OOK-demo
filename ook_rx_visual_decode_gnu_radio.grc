- name: epy_block_0
  id: epy_block
  parameters:
    _source_code: "import numpy as np\nfrom gnuradio import gr\nimport pmt\n\nclass blk(gr.sync_block):\n    \"\"\"Seuil adaptatif,\
      \ reconstruction temporelle et décodage ASCII OOK.\"\"\"\n    def __init__(self, samp_rate=2000000, bit_duration=0.300):\n\
      \        gr.sync_block.__init__(self, name=\"OOK ASCII decoder\", in_sig=[np.float32], out_sig=None)\n        self.message_port_register_out(pmt.intern(\"\
      msg\"))\n        self.samp_rate = float(samp_rate)\n        self.bit_duration = float(bit_duration)\n        self.oversample\
      \ = 5\n        # Une mesure toutes les 1/5 de durée de bit, comme dans jouuuj.py.\n        self.samples_per_measure\
      \ = max(1, int(self.samp_rate * self.bit_duration / self.oversample))\n        self.counter = 0\n        self.level_history\
      \ = []\n        self.raw_symbols = []\n        self.last_text = \"\"\n        self.preamble = \"1010101011\"\n\n   \
      \ def _reconstruct_bits(self):\n        if not self.raw_symbols:\n            return \"\"\n        runs = []\n     \
      \   current = self.raw_symbols[0]\n        run_len = 1\n        for symbol in self.raw_symbols[1:]:\n            if\
      \ symbol == current:\n                run_len += 1\n            else:\n                runs.append((current, run_len))\n\
      \                current, run_len = symbol, 1\n        runs.append((current, run_len))\n        bits = []\n        for\
      \ symbol, length in runs:\n            n_bits = max(1, int(round(length / self.oversample)))\n            bits.append(symbol\
      \ * n_bits)\n        return \"\".join(bits)\n\n    def _decode(self, bitstream):\n        idx = bitstream.find(self.preamble)\n\
      \        if idx < 0:\n            return \"\"\n        payload = bitstream[idx + len(self.preamble):]\n        chars\
      \ = []\n        # Le flux peut se terminer au milieu d'un octet : on ignore ces bits.\n        for j in range(0, len(payload)\
      \ - 7, 8):\n            byte_bits = payload[j:j+8]\n            value = int(byte_bits, 2)\n            if 32 <= value\
      \ <= 126:\n                chars.append(chr(value))\n            else:\n                break\n        return \"\".join(chars)\n\
      \n    def work(self, input_items, output_items):\n        for value in input_items[0]:\n            self.counter +=\
      \ 1\n            if self.counter < self.samples_per_measure:\n                continue\n            self.counter = 0\n\
      \            level = float(value)\n            self.level_history.append(level)\n            self.level_history = self.level_history[-60:]\n\
      \            if len(self.level_history) < 10:\n                continue\n            lo, hi = min(self.level_history),\
      \ max(self.level_history)\n            if hi - lo < 0.02:\n                continue\n            threshold = (lo + hi)\
      \ / 2.0\n            self.raw_symbols.append('1' if level > threshold else '0')\n            self.raw_symbols = self.raw_symbols[-400:]\n\
      \            bitstream = self._reconstruct_bits()\n            text = self._decode(bitstream)\n            if text and\
      \ text != self.last_text:\n                self.message_port_pub(pmt.intern(\"msg\"), pmt.intern(text))\n          \
      \      self.last_text = text\n        return len(input_items[0])\n"
    _source_code_mode: '0'
    affinity: ''
    alias: ''
    comment: Décodage OOK avec échantillonnage x5 et reconstruction des paliers
    maxoutbuf: '0'
    minoutbuf: '0'
    num_inputs: '1'
    num_outputs: '0'
    samp_rate: samp_rate
    bit_duration: '0.300'
    type: float
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 680
    - 500
    rotation: 0
    state: enabled
